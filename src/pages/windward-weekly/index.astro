---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Signup from '../../components/Signup.astro';
import { site } from '../../config/site';

const issues = (await getCollection('weekly', ({ data }) => !data.draft)).sort((a, b) => b.data.issue - a.data.issue);
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout title="Windward Weekly" description="The Windward Weekly: a free weekly guide to family life, events, food and things to do around Kailua and windward Oʻahu.">
  <PageHeader eyebrow="The newsletter" title="The Windward Weekly" intro="A free weekly guide to family life, events, food and things to do around Kailua and windward Oʻahu." />
  <Signup />
  <section class="wrap section" id="past-issues" aria-labelledby="past-title">
    <div class="head">
      <h2 id="past-title" class="display">Past issues</h2>
      <a class="more" href={site.beehiivArchiveUrl} target="_blank" rel="noopener">Full archive on beehiiv<span class="sr-only"> (opens in a new tab)</span></a>
    </div>
    <ul class="issues">
      {issues.map((i) => {
        const main = i.data.webUrl || i.data.beehiivUrl;
        return (
          <li class="issue postcard">
            {i.data.image && (
              <a class="thumb" href={main} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
                <img src={i.data.image} alt="" loading="lazy" />
              </a>
            )}
            <div class="body">
              <p class="eyebrow">Issue {i.data.issue} · {fmt(i.data.date)}</p>
              <h3 class="display"><a href={main} target="_blank" rel="noopener">{i.data.title}<span class="sr-only"> (opens in a new tab)</span></a></h3>
              <p class="summary">{i.data.summary}</p>
              <div class="links">
                {i.data.webUrl && <a class="btn" href={i.data.webUrl} target="_blank" rel="noopener">Read the issue<span class="sr-only"> (opens in a new tab)</span></a>}
                {i.data.beehiivUrl && <a class="btn btn--ghost" href={i.data.beehiivUrl} target="_blank" rel="noopener">Email version<span class="sr-only"> (opens in a new tab)</span></a>}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>
<style>
  .head { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: baseline; justify-content: space-between; margin-bottom: 28px; }
  .head h2 { font-size: clamp(32px, 4vw, 44px); }
  .more { font-size: 14px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--teal); }
  .issues { list-style: none; margin: 0; padding: 0; display: grid; gap: 28px; }
  .issue { display: flex; flex-wrap: wrap; gap: 28px; padding: 16px; box-shadow: 8px 8px 0 var(--teal); }
  .thumb { flex: 1 1 320px; min-width: 0; }
  .thumb img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .body { flex: 999 1 360px; min-width: 0; padding: 8px 8px 8px 0; }
  h3 { margin: 8px 0 0; font-size: clamp(30px, 3.6vw, 40px); }
  h3 a { text-decoration: none; }
  .summary { margin: 12px 0 0; font-size: 18px; color: var(--ink-soft); max-width: 560px; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
---
<BaseLayout title="Community">
  <PageHeader eyebrow="Community" title="Kailua helping Kailua" intro="Fundraisers, lost and found, events and neighbors helping neighbors. Coming soon." />
  <section class="wrap" style="padding-bottom: 96px">
    <div class="postcard" style="padding: 14px; box-shadow: var(--shadow)">
      <img class="vintage" src="/media/photos/hiker-olomana.webp" alt="A hiker looking out at Olomana and the Koolau range" style="width: 100%; aspect-ratio: 21 / 9; object-fit: cover" />
    </div>
  </section>
</BaseLayout>

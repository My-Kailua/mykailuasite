---
import { site } from '../config/site';
const path = Astro.url.pathname;
---
<div class="ribbon">{site.tagline}</div>
<header class="header wrap">
  <a class="logo" href="/" aria-label="My Kailua home">My <em>Kailua</em></a>

  <nav class="nav" aria-label="Main">
    <ul>
      {site.nav.map((item) => (
        <li>
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        </li>
      ))}
    </ul>
  </nav>

  <details class="menu">
    <summary>Menu</summary>
    <ul>
      {site.nav.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
  </details>
</header>

<style>
  .ribbon {
    background: var(--teal);
    color: var(--paper);
    text-align: center;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 26px;
    padding-bottom: 26px;
  }
  .logo {
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1;
    color: var(--coral-text);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav ul, .menu ul { list-style: none; margin: 0; padding: 0; }
  .nav ul { display: flex; flex-wrap: wrap; gap: 26px; justify-content: flex-end; }
  .nav a, .menu a {
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .nav a[aria-current='page'] { color: var(--coral-text); text-decoration: underline; text-underline-offset: 6px; }

  .menu { display: none; position: relative; }
  .menu summary {
    list-style: none;
    cursor: pointer;
    padding: 10px 18px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 14px;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    z-index: 10;
    min-width: 230px;
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 6px 6px 0 var(--teal);
    padding: 8px 0;
  }
  .menu li a { display: block; padding: 12px 20px; }

  @media (max-width: 960px) {
    .nav { display: none; }
    .menu { display: block; }
  }
</style>

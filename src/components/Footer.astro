---
import { site } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="wrap inner">
    <div>
      <p class="mark">My <em>Kailua</em></p>
      <p class="sub">{site.description}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {site.nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <ul class="social" aria-label="Follow My Kailua">
      <li><a href={site.social.instagram}>Instagram</a></li>
      <li><a href={site.social.facebook}>Facebook</a></li>
      <li><a href={site.social.youtube}>YouTube</a></li>
    </ul>
  </div>
  <p class="wrap legal">© {year} My Kailua. Made on the windward side of Oahu.</p>
</footer>

<style>
  .footer { background: var(--ink); color: var(--sand); padding: 56px 0 28px; }
  .inner { display: flex; flex-wrap: wrap; gap: 40px; justify-content: space-between; }
  .mark { margin: 0; font-family: var(--font-display); font-size: 36px; color: var(--paper); }
  .sub { margin: 10px 0 0; max-width: 380px; color: #D9CDB6; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  a { text-decoration: none; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; font-size: 13px; }
  a:hover { color: #F3A27F; }
  .legal { margin-top: 40px; font-size: 13px; color: #BFB39C; }
</style>
